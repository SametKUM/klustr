---
import CompareTable from '../../components/CompareTable.astro'
import CompareLayout from '../../layouts/CompareLayout.astro'
import { COMPARE_PAGES, REVIEWED_ON, TOOLS, type ToolId } from '../../data/compare'
import { breadcrumbLd, graph } from '../../lib/seo'
import { ISSUES_URL } from '../../lib/site'

const description =
  'Klustr compared with Lens, k9s, Headlamp and Kubernetes Dashboard on license, sign-in, what runs in the cluster, multi-cluster, RBAC, Helm, Argo CD, Flux, Gateway API, logs and terminals.'

const allTools: ToolId[] = ['klustr', 'lens', 'k9s', 'headlamp', 'dashboard']
---

<CompareLayout
  title="Klustr compared with other Kubernetes UIs"
  eyebrow="compare"
  lede="Lens, k9s, Headlamp and Kubernetes Dashboard are all good tools with different shapes. This page puts them next to Klustr on the questions people ask before switching, and links to a page for each."
  description={description}
  path="/compare/"
  ogType="website"
  jsonLd={graph([breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Compare', path: '/compare/' }])])}
>
  <section class="mt-10">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
      <h2 id="at-a-glance" class="display scroll-mt-24 text-2xl">At a glance</h2>
      <p class="font-mono text-sm text-ink-3">14 rows, reviewed {REVIEWED_ON}</p>
    </div>
    <CompareTable tools={allTools} class="mt-5" />
  </section>

  <section class="mt-14">
    <h2 id="pages" class="display scroll-mt-24 text-2xl">Head-to-head pages</h2>
    <p class="lede mt-3 max-w-[68ch]">Each page goes row by row and says where that tool is the better pick.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        COMPARE_PAGES.map((page) => (
          <a href={`/compare/${page.slug}/`} class="sheet cap block no-underline hover:border-ink">
            <h3>{page.heading}</h3>
            <p>{TOOLS[page.tool].summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="prose mt-14">
    <h2 id="method">How this table is kept honest</h2>
    <p>
      Every cell about another tool comes from that tool’s public documentation, README or release notes, and the
      table was last reviewed on {REVIEWED_ON}. Cells are worded as capabilities, not judgements, and where a feature
      exists only through plugins or extensions the cell says so. There are no memory or speed numbers here because
      none have been measured side by side.
    </p>
    <p>
      If a row is wrong or out of date, <a href={ISSUES_URL}>open an issue</a> with a link to the source and it will be
      corrected.
    </p>
  </section>
</CompareLayout>
