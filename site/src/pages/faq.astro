---
import DocsLayout from '../layouts/DocsLayout.astro'
import { FAQ } from '../data/faq'
import { renderFragment, stripMarkdown } from '../lib/markdown'
import { breadcrumbLd, faqLd, graph } from '../lib/seo'

const description =
  'Answers about Klustr: what it installs in the cluster (nothing), supported platforms, license, telemetry, authentication with exec plugins and aws-vault, multi-cluster mode, read-only mode, RBAC-scoped lists and custom resources.'

const items = FAQ.map((f) => ({
  ...f,
  html: renderFragment(f.answer),
  text: stripMarkdown(f.answer),
}))

const headings = items.map((f) => ({ depth: 2, id: f.id, text: f.question }))

const jsonLd = graph([
  faqLd(items.map((f) => ({ question: f.question, answerText: f.text }))),
  breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'FAQ', path: '/faq/' }]),
])
---

<DocsLayout
  title="Frequently asked questions"
  eyebrow="faq"
  lede="Short answers with links to the guide that goes deeper. If your question is missing, open an issue and it will be added here."
  description={description}
  path="/faq/"
  headings={headings}
  jsonLd={jsonLd}
>
  <div class="prose">
    {
      items.map((f) => (
        <section class="mt-10 first:mt-0">
          <h2 id={f.id}>{f.question}</h2>
          <Fragment set:html={f.html} />
        </section>
      ))
    }
  </div>
</DocsLayout>
