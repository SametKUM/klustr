---
import { Picture } from 'astro:assets'
import { ArrowRight } from '@lucide/astro'
import type { Shot } from '../data/shots'

export type Feature = {
  id: string
  eyebrow: string
  heading: string
  body: string
  chips: { value: string; label: string }[]
  shot: Shot
  link: { href: string; label: string }
}

interface Props {
  features: Feature[]
}

const { features } = Astro.props
---

<div class="wf" data-feature-tabs>
  <div class="wf-tabs" role="tablist" aria-label="Workflows">
    {
      features.map((f, i) => (
        <button
          type="button"
          role="tab"
          class="wf-tab"
          id={`wf-tab-${f.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`wf-panel-${f.id}`}
          tabindex={i === 0 ? 0 : -1}
          data-wf-tab={f.id}
        >
          {f.eyebrow}
        </button>
      ))
    }
  </div>

  {
    features.map((f, i) => (
      <div
        class="wf-panel"
        role="tabpanel"
        id={`wf-panel-${f.id}`}
        aria-labelledby={`wf-tab-${f.id}`}
        data-wf-panel={f.id}
        hidden={i !== 0}
      >
        <div class="wf-head">
          <div class="wf-copy">
            <h3 class="display text-2xl sm:text-[1.75rem]">{f.heading}</h3>
            <p class="lede mt-3">{f.body}</p>
          </div>
          <div class="wf-facts">
            <div class="wf-chips">
              {f.chips.map((chip) => (
                <div class="sheet chip">
                  <div class="chip-value">{chip.value}</div>
                  <div class="chip-label">{chip.label}</div>
                </div>
              ))}
            </div>
            <a href={f.link.href} class="wf-link">
              {f.link.label}
              <ArrowRight size={14} />
            </a>
          </div>
        </div>
        <figure class="wf-shot sheet ticks">
          <Picture
            src={f.shot.image}
            alt={`Klustr ${f.shot.title} view in the ${f.shot.theme} theme. ${f.shot.caption}`}
            widths={[640, 1200, 1800, 2560]}
            sizes="(max-width: 1200px) 100vw, 1152px"
            formats={['avif']}
            fallbackFormat="webp"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
          <figcaption class="wf-caption">
            <span>{f.shot.title}</span>
            <span class="font-mono">{f.shot.theme}</span>
          </figcaption>
        </figure>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-feature-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-wf-tab]')]
    const panels = [...root.querySelectorAll<HTMLElement>('[data-wf-panel]')]

    function activate(id: string, focus = false) {
      tabs.forEach((tab) => {
        const on = tab.dataset.wfTab === id
        tab.setAttribute('aria-selected', String(on))
        tab.tabIndex = on ? 0 : -1
        if (on && focus) tab.focus()
      })
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.wfPanel !== id
      })
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(tab.dataset.wfTab ?? ''))
      tab.addEventListener('keydown', (e) => {
        const delta = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
        if (!delta) return
        e.preventDefault()
        const next = tabs[(i + delta + tabs.length) % tabs.length]
        activate(next.dataset.wfTab ?? '', true)
      })
    })
  })
</script>
