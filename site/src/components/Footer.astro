---
import {
  CONTRIBUTING_URL,
  ISSUES_URL,
  LICENSE_URL,
  RELEASES_URL,
  REPO_URL,
  SECURITY_URL,
  SITE,
} from '../lib/site'

const product = [
  { href: '/#features', label: 'Features' },
  { href: '/install/', label: 'Install' },
  { href: '/compare/', label: 'Compare' },
  { href: '/docs/', label: 'Docs' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/changelog/', label: 'Changelog' },
]

const project = [
  { href: REPO_URL, label: 'GitHub' },
  { href: RELEASES_URL, label: 'Releases' },
  { href: ISSUES_URL, label: 'Issues' },
  { href: CONTRIBUTING_URL, label: 'Contributing' },
  { href: SECURITY_URL, label: 'Security policy' },
  { href: LICENSE_URL, label: 'MIT license' },
]
---

<footer class="mx-auto max-w-6xl px-5 pb-12 pt-6">
  <div class="rule-x mb-10"></div>
  <div class="grid gap-10 sm:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <div class="flex items-center gap-2.5">
        <img src="/appicon.png" alt="" width="26" height="26" class="rounded-md" />
        <span class="font-mono font-bold">Klustr</span>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-ink-2">{SITE.tagline}.</p>
    </div>
    <div>
      <p class="side-group">product</p>
      <ul class="flex flex-col gap-1.5 text-sm">
        {
          product.map((l) => (
            <li>
              <a href={l.href} class="nav-link">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="side-group">project</p>
      <ul class="flex flex-col gap-1.5 text-sm">
        {
          project.map((l) => (
            <li>
              <a href={l.href} class="nav-link" target="_blank" rel="noreferrer">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="mt-10 flex flex-col items-start justify-between gap-3 text-xs text-ink-3 sm:flex-row sm:items-center">
    <p>MIT © {SITE.author}. Built with Wails, client-go, React and Tailwind.</p>
    <p class="font-mono">Not affiliated with the Kubernetes project or the CNCF.</p>
  </div>
</footer>
