---
import { Picture, getImage } from 'astro:assets'
import { ChevronLeft, ChevronRight, X } from '@lucide/astro'
import { SHOTS } from '../data/shots'

const slides = await Promise.all(
  SHOTS.map(async (shot) => ({
    ...shot,
    full: await getImage({ src: shot.image, width: 1920, format: 'webp' }),
  })),
)
const first = slides[0]
---

<div class="slider" data-slider>
  <div class="slider-frame ticks">
    {
      slides.map((shot, i) => (
        <figure
          class:list={['slide', { 'is-active': i === 0 }]}
          data-slide
          data-title={shot.title}
          data-theme={shot.theme}
          data-caption={shot.caption}
          data-full={shot.full.src}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <Picture
            src={shot.image}
            alt={`Klustr ${shot.title} view in the ${shot.theme} theme. ${shot.caption}`}
            widths={[640, 1200, 1800]}
            sizes="(max-width: 1200px) 100vw, 1152px"
            formats={['avif']}
            fallbackFormat="webp"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
            data-lightbox
          />
          <figcaption class="sr-only">{shot.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <div class="slider-bar sheet">
    <div class="slider-copy">
      <span class="slider-count" data-count>01 / {String(slides.length).padStart(2, '0')}</span>
      <span class="slider-title" data-title>{first.title}</span>
      <span class="slider-theme" data-theme>{first.theme} theme</span>
    </div>
    <div class="flex flex-none items-center gap-3">
      <div class="slider-dots hidden sm:flex" data-dots>
        {
          slides.map((shot, i) => (
            <button
              class:list={['slider-dot', { 'is-active': i === 0 }]}
              type="button"
              data-goto={i}
              aria-label={`Show ${shot.title}`}
            />
          ))
        }
      </div>
      <button class="icon-btn" type="button" data-prev aria-label="Previous screenshot">
        <ChevronLeft size={16} />
      </button>
      <button class="icon-btn" type="button" data-next aria-label="Next screenshot">
        <ChevronRight size={16} />
      </button>
    </div>
  </div>
  <p class="mt-3 text-center text-sm text-ink-2" data-caption>{first.caption}</p>
</div>

<div
  id="lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Screenshot"
  aria-hidden="true"
>
  <button class="icon-btn absolute right-4 top-4" type="button" data-lb-close aria-label="Close">
    <X size={18} />
  </button>
  <button class="icon-btn absolute left-3 top-1/2 -translate-y-1/2 sm:left-6" type="button" data-lb-prev aria-label="Previous">
    <ChevronLeft size={18} />
  </button>
  <button class="icon-btn absolute right-3 top-1/2 -translate-y-1/2 sm:right-6" type="button" data-lb-next aria-label="Next">
    <ChevronRight size={18} />
  </button>
  <figure class="max-h-[90vh] w-full max-w-6xl">
    <img data-lb-img src="" alt="" class="mx-auto max-h-[82vh] w-auto rounded-(--radius-sheet) border border-rule-strong" />
    <figcaption data-lb-caption class="mt-4 text-center font-mono text-sm text-ink-2"></figcaption>
  </figure>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-slider]')
  const lb = document.getElementById('lightbox')
  if (root && lb) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')]
    const dots = [...root.querySelectorAll<HTMLElement>('[data-goto]')]
    const count = root.querySelector<HTMLElement>('[data-count]')
    const title = root.querySelector<HTMLElement>('[data-title]')
    const theme = root.querySelector<HTMLElement>('[data-theme]')
    const caption = root.querySelector<HTMLElement>('[data-caption]')
    const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')
    const lbCap = lb.querySelector<HTMLElement>('[data-lb-caption]')
    const total = slides.length
    let index = 0

    function show(i: number) {
      index = (i + total) % total
      slides.forEach((s, n) => {
        const active = n === index
        s.classList.toggle('is-active', active)
        s.setAttribute('aria-hidden', String(!active))
      })
      dots.forEach((d, n) => d.classList.toggle('is-active', n === index))
      const s = slides[index]
      if (count) count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`
      if (title) title.textContent = s.dataset.title ?? ''
      if (theme) theme.textContent = `${s.dataset.theme ?? ''} theme`
      if (caption) caption.textContent = s.dataset.caption ?? ''
    }

    root.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1))
    root.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1))
    dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.goto))))

    function renderLightbox() {
      const s = slides[index]
      if (!lbImg || !lbCap) return
      lbImg.src = s.dataset.full ?? ''
      lbImg.alt = `${s.dataset.title} view in the ${s.dataset.theme} theme`
      lbCap.textContent = `${s.dataset.title}. ${s.dataset.caption}`
    }
    function openLightbox() {
      renderLightbox()
      lb!.classList.remove('hidden')
      lb!.classList.add('flex')
      lb!.setAttribute('aria-hidden', 'false')
      document.body.style.overflow = 'hidden'
    }
    function closeLightbox() {
      lb!.classList.add('hidden')
      lb!.classList.remove('flex')
      lb!.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = ''
    }

    slides.forEach((s) => s.querySelector('img')?.addEventListener('click', openLightbox))
    lb.querySelector('[data-lb-close]')?.addEventListener('click', closeLightbox)
    lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => {
      show(index - 1)
      renderLightbox()
    })
    lb.querySelector('[data-lb-next]')?.addEventListener('click', () => {
      show(index + 1)
      renderLightbox()
    })
    lb.addEventListener('click', (e) => {
      if (e.target === lb) closeLightbox()
    })
    document.addEventListener('keydown', (e) => {
      const open = !lb!.classList.contains('hidden')
      if (e.key === 'Escape' && open) closeLightbox()
      else if (e.key === 'ArrowLeft') {
        show(index - 1)
        if (open) renderLightbox()
      } else if (e.key === 'ArrowRight') {
        show(index + 1)
        if (open) renderLightbox()
      }
    })
  }
</script>
