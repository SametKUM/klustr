---
import { Picture, getImage } from 'astro:assets'
import { ChevronLeft, ChevronRight, X } from '@lucide/astro'
import { SHOTS } from '../data/shots'

const slides = await Promise.all(
  SHOTS.map(async (shot) => ({
    ...shot,
    full: await getImage({ src: shot.image, width: 2560, format: 'webp' }),
  })),
)
const first = slides[0]
const total = String(slides.length).padStart(2, '0')
---

<div class="slider" data-slider>
  <div class="slider-frame ticks">
    {
      slides.map((shot, i) => (
        <figure
          class:list={['slide', { 'is-active': i === 0 }]}
          data-slide
          data-shot-title={shot.title}
          data-shot-theme={shot.theme}
          data-shot-caption={shot.caption}
          data-shot-guide-href={shot.guide.href}
          data-shot-guide-label={shot.guide.label}
          data-full={shot.full.src}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <Picture
            src={shot.image}
            alt={`Klustr ${shot.title} view in the ${shot.theme} theme. ${shot.caption}`}
            widths={[640, 1200, 1800, 2560]}
            sizes="(max-width: 1200px) 100vw, 1152px"
            formats={['avif']}
            fallbackFormat="webp"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
          />
          <figcaption class="sr-only">{shot.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <div class="slider-bar sheet">
    <div class="min-w-0 flex-1">
      <div class="slider-copy">
        <span class="slider-count" data-bar-count>01 / {total}</span>
        <span class="slider-title" data-bar-title>{first.title}</span>
        <span class="slider-theme" data-bar-theme>{first.theme}</span>
      </div>
      <p class="slider-caption">
        <span data-bar-caption>{first.caption}</span>
        <a class="slider-guide" href={first.guide.href} data-bar-guide>{first.guide.label}</a>
      </p>
    </div>
    <div class="flex flex-none items-center gap-2 self-start">
      <button class="icon-btn" type="button" data-prev aria-label="Previous screenshot">
        <ChevronLeft size={16} />
      </button>
      <button class="icon-btn" type="button" data-next aria-label="Next screenshot">
        <ChevronRight size={16} />
      </button>
    </div>
  </div>
</div>

<div
  id="lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Screenshot"
  aria-hidden="true"
>
  <button class="icon-btn absolute right-4 top-4" type="button" data-lb-close aria-label="Close">
    <X size={18} />
  </button>
  <button class="icon-btn absolute left-3 top-1/2 -translate-y-1/2 sm:left-6" type="button" data-lb-prev aria-label="Previous">
    <ChevronLeft size={18} />
  </button>
  <button class="icon-btn absolute right-3 top-1/2 -translate-y-1/2 sm:right-6" type="button" data-lb-next aria-label="Next">
    <ChevronRight size={18} />
  </button>
  <figure class="max-h-[92vh] w-full max-w-7xl">
    <img data-lb-img src="" alt="" class="mx-auto max-h-[80vh] w-auto rounded-(--radius-sheet) border border-rule-strong" />
    <figcaption data-lb-caption class="mx-auto mt-4 max-w-3xl text-center text-sm text-ink-2"></figcaption>
  </figure>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-slider]')
  const lb = document.getElementById('lightbox')
  if (root && lb) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')]
    const count = root.querySelector<HTMLElement>('[data-bar-count]')
    const title = root.querySelector<HTMLElement>('[data-bar-title]')
    const caption = root.querySelector<HTMLElement>('[data-bar-caption]')
    const theme = root.querySelector<HTMLElement>('[data-bar-theme]')
    const guide = root.querySelector<HTMLAnchorElement>('[data-bar-guide]')
    const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')
    const lbCap = lb.querySelector<HTMLElement>('[data-lb-caption]')
    const total = slides.length
    let index = 0

    function show(i: number) {
      index = (i + total) % total
      slides.forEach((s, n) => {
        const active = n === index
        s.classList.toggle('is-active', active)
        s.setAttribute('aria-hidden', String(!active))
      })
      const s = slides[index]
      if (count) count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`
      if (title) title.textContent = s.dataset.shotTitle ?? ''
      if (caption) caption.textContent = s.dataset.shotCaption ?? ''
      if (theme) theme.textContent = s.dataset.shotTheme ?? ''
      if (guide) {
        guide.href = s.dataset.shotGuideHref ?? '/docs/'
        guide.textContent = s.dataset.shotGuideLabel ?? 'Guide'
      }
    }

    root.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1))
    root.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1))

    function renderLightbox() {
      const s = slides[index]
      if (!lbImg || !lbCap) return
      lbImg.src = s.dataset.full ?? ''
      lbImg.alt = `${s.dataset.shotTitle} view in the ${s.dataset.shotTheme} theme`
      lbCap.textContent = `${s.dataset.shotTitle}. ${s.dataset.shotCaption}`
    }
    function openLightbox() {
      renderLightbox()
      lb!.classList.remove('hidden')
      lb!.classList.add('flex')
      lb!.setAttribute('aria-hidden', 'false')
      document.body.style.overflow = 'hidden'
    }
    function closeLightbox() {
      lb!.classList.add('hidden')
      lb!.classList.remove('flex')
      lb!.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = ''
    }

    slides.forEach((s) => s.querySelector('img')?.addEventListener('click', openLightbox))
    lb.querySelector('[data-lb-close]')?.addEventListener('click', closeLightbox)
    lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => {
      show(index - 1)
      renderLightbox()
    })
    lb.querySelector('[data-lb-next]')?.addEventListener('click', () => {
      show(index + 1)
      renderLightbox()
    })
    lb.addEventListener('click', (e) => {
      if (e.target === lb) closeLightbox()
    })
    document.addEventListener('keydown', (e) => {
      const open = !lb!.classList.contains('hidden')
      if (e.key === 'Escape' && open) closeLightbox()
      else if (e.key === 'ArrowLeft') {
        show(index - 1)
        if (open) renderLightbox()
      } else if (e.key === 'ArrowRight') {
        show(index + 1)
        if (open) renderLightbox()
      }
    })
  }
</script>
