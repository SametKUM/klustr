---
import { COMPARE_PAGES, ROWS, TOOLS, type ToolId } from '../data/compare'

interface Props {
  tools: ToolId[]
  rows?: string[]
  compact?: boolean
  class?: string
}

const { tools, rows: rowLabels, compact = false, class: className = '' } = Astro.props
const rows = rowLabels ? ROWS.filter((r) => rowLabels.includes(r.label)) : ROWS
const pageFor = (id: ToolId) => COMPARE_PAGES.find((p) => p.tool === id)
---

<div class:list={['cmp-wrap', { 'cmp-compact': compact }, className]}>
  <table class="cmp">
    <thead>
      <tr>
        <th scope="col"><span class="sr-only">Criterion</span></th>
        {
          tools.map((id) => {
            const page = pageFor(id)
            return (
              <th scope="col" class:list={{ hl: id === 'klustr' }}>
                {page ? (
                  <a href={`/compare/${page.slug}/`} class="cmp-tool" title={`Klustr vs ${TOOLS[id].name}`}>
                    {TOOLS[id].name}
                  </a>
                ) : (
                  TOOLS[id].name
                )}
              </th>
            )
          })
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            {tools.map((id) => {
              const cell = row.cells[id]
              return (
                <td class:list={{ hl: id === 'klustr' }}>
                  <span class:list={[cell.tone]}>{cell.text}</span>
                  {cell.sub && <span class="sub">{cell.sub}</span>}
                </td>
              )
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
